# ============================================================
# 环境变量示例文件
# 使用方法：复制为 .env 后填入你自己的密钥
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
# .env 已在 .gitignore 中，不会被提交到仓库
# ============================================================

# ---------- 大模型 API ----------
# 01 / 02 的脚本读取的就是这个变量名（注意是小写 deepseek）
# 申请地址：https://platform.deepseek.com/api_keys
deepseek_API_KEY=your_deepseek_api_key_here

# ---------- 03 RAG：大模型（OpenAI 兼容网关）----------
# 网关地址与模型名要配套：deepseek-v4.1-flash-1017 是下面这台网关上注册的名字
LLM_BASE_URL=https://tokenrhythm.studio/v1
LLM_MODEL=deepseek-v4.1-flash-1017
# 若改用火山方舟直连大模型，则换成：
#   LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   LLM_MODEL=deepseek-v4-1-flash-261017
#   LLM_API_KEY=你的方舟 API Key

# ---------- 03 RAG：向量模型（火山方舟 Ark）----------
# 控制台：火山引擎 -> 火山方舟 -> API Key 管理
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=your_ark_api_key_here
# 首选豆包文本向量；若当前账号未开通，会自动按 EMBEDDING_FALLBACKS 顺序回退
EMBEDDING_MODEL=doubao-embedding-text-240715
EMBEDDING_FALLBACKS=doubao-embedding-large-text-250515,doubao-embedding-vision-251215
EMBEDDING_BATCH_SIZE=10
